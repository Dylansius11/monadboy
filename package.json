{
  "name": "monadboy",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "guard": "bun scripts/guard-forbidden.ts",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "generate-routes": "bun run --cwd apps/web generate-routes",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd packages/sdk typecheck",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "bun run --cwd apps/web test && bun run --cwd packages/sdk test",
    "test:watch": "bun run --cwd apps/web test:watch",
    "test:ui": "bun run --cwd apps/web test:ui",
    "test:coverage": "bun run --cwd apps/web test:coverage",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/intent": "0.5.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "trustedDependencies": ["esbuild", "lightningcss", "unrs-resolver"],
  "intent": {
    "skills": [
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/devtools-vite"
    ],
    "exclude": [
      "@tanstack/react-start#lifecycle/migrate-from-nextjs",
      "@tanstack/react-start#react-start/server-components",
      "@tanstack/start-client-core#start-core/auth-server-primitives"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}

# Copy to .env.local. Every VITE_ variable is public: never put a key here.

# The worker's REST base address, no trailing path. Without it the tracker and
# leaderboard say so and show nothing; there is no localhost default.
# Local worker: http://127.0.0.1:8787 (its APP_ORIGIN must be this app's origin).
VITE_WORKER_URL=

# Fixed passkey hostname before real cards are created. No scheme or port.
# Leave unset until the production hostname is chosen. /dev/passkey uses
# disposable cards on its own localhost/HTTPS hostname and sends no transaction.
VITE_RP_ID=
VITE_RP_NAME=MONADBOY

# Deployed DiskRegistry v2 address, verified on chain10143 before use.
# Missing config is an explicit read/save error; never point production at Anvil.
VITE_REGISTRY_ADDRESS=
VITE_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Dev only. `true` keeps the marked development fixtures (pool tracker data and
# the simulated S6 to S8 walk) in `bun run dev`. Production builds ignore it.
VITE_USE_FIXTURES=

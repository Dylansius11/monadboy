# Copy to .env. Blank means unset (the default applies). Never commit a filled copy.
WORKER_PORT=
# Listener address; keep loopback and put Caddy in front of it.
WORKER_BIND=
# The single origin allowed by CORS.
APP_ORIGIN=
# Optional exact IPv4 address of container Caddy; leave blank for host loopback.
# Other peers cannot override their drip quota IP with forwarded headers.
TRUSTED_PROXY_IP=
TESTNET_RPC_URL=
MAINNET_RPC_URL=
# Distinct keys from `cast wallet new`; read-only operation needs neither.
BOT_PRIVATE_KEY=
DRIP_PRIVATE_KEY=
SQLITE_PATH=
ENVIO_GRAPHQL_URL=
# Deployed testnet market file (same shape as packages/sdk/src/markets.testnet.json).
MARKETS_JSON=
# Optional. Backfills the 24h trade window from HyperSync instead of 100-block RPC chunks.
HYPERSYNC_API_TOKEN=
HYPERSYNC_URL=
# RPC fallback only: log-chunk parallelism. HyperSync always runs one chunk at a time (15000 units/minute budget).
TRACKER_LOG_CONCURRENCY=
# Must be true for the worker to sign anything.
ENABLE_TRANSACTIONS=
# Mirror AUSD per ladder side (default 4, bounded by margin inventory) and AUSD one tick may
# take from other makers (default 5).
MIRROR_SIDE_NOTIONAL=
MIRROR_MAX_STEP_NOTIONAL=
# Gap between ladder checks while a player is active (default 60000 ms, 5000..600000) and the
# fraction the DEMO target must move before a new ladder is signed (default 0.01, 0..0.05).
MIRROR_INTERVAL_MS=
MIRROR_DEADBAND=
# Relative movement amplification of the playable DEMO target, 1..50 (default 20; 50 only for a live demo).
DEMO_MULTIPLIER=
# Maximum UTC-day mirror gas in MON (default 10); reserved before signing, settled to the
# billed receipt cost, durable across restarts.
MIRROR_DAILY_GAS_MON=
# Gas ceilings bound fresh estimation; each send declares estimate +10%, never these values.
# Market order default 2M, batchUpdate default 4M (a full ladder seed). ERC20/faucet defaults
# 87502/156720 are successful testnet receipt samples, not worst cases.
GAS_MARKET_ORDER=
GAS_BATCH_UPDATE=
GAS_ERC20=
GAS_FAUCET=
# Drip amounts in whole tokens, the fresh-disk MON ceiling, and the global daily cap.
DRIP_MON=
DRIP_AUSD=
DRIP_MON_THRESHOLD=
DRIP_DAILY_CAP=
# At least 32 random characters; keeps the IP hash stable and unguessable.
DRIP_IP_SALT=
# Faucet top-up threshold and the health alarm floors (whole tokens).
FAUCET_MIN_AUSD=
TREASURY_MIN_MON=
TREASURY_MIN_AUSD=
# First market block. Default manifest inherits deployments.testnet.json; custom MARKETS_JSON requires this.
TESTNET_START_BLOCK=
TESTNET_MARGIN_ADDRESS=
TESTNET_AUSD_ADDRESS=
TESTNET_FAUCET_ADDRESS=
TESTNET_REGISTRY_ADDRESS=

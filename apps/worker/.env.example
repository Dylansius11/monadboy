# Copy to .env. Blank means unset (the default applies). Never commit a filled copy.
WORKER_PORT=
# Listener address; keep loopback and put Caddy in front of it.
WORKER_BIND=
# The single origin allowed by CORS.
APP_ORIGIN=
TESTNET_RPC_URL=
MAINNET_RPC_URL=
# Distinct keys from `cast wallet new`; read-only operation needs neither.
BOT_PRIVATE_KEY=
DRIP_PRIVATE_KEY=
SQLITE_PATH=
ENVIO_GRAPHQL_URL=
# Deployed testnet market file (same shape as packages/sdk/src/markets.testnet.json).
MARKETS_JSON=
# Optional. Backfills the 24h trade window from HyperSync instead of 100-block RPC chunks.
HYPERSYNC_API_TOKEN=
HYPERSYNC_URL=
# RPC fallback only: log-chunk parallelism. HyperSync always runs one chunk at a time (15000 units/minute budget).
TRACKER_LOG_CONCURRENCY=
# Must be true for the worker to sign anything.
ENABLE_TRANSACTIONS=
# Mirror: quote units per tick, and the deviation (fraction of the target) that triggers a trade.
MIRROR_MAX_STEP_NOTIONAL=
MIRROR_DEVIATION_THRESHOLD=
# [U, S2] explicit gas limits; replace the conservative defaults with measured values.
GAS_MARKET_ORDER=
GAS_BATCH_UPDATE=
GAS_ERC20=
GAS_FAUCET=
# Drip amounts in whole tokens, the fresh-disk MON ceiling, and the global daily cap.
DRIP_MON=
DRIP_AUSD=
DRIP_MON_THRESHOLD=
DRIP_DAILY_CAP=
# At least 32 random characters; keeps the IP hash stable and unguessable.
DRIP_IP_SALT=
# Faucet top-up threshold and the health alarm floors (whole tokens).
FAUCET_MIN_AUSD=
TREASURY_MIN_MON=
TREASURY_MIN_AUSD=
# First block of the testnet market; direct fill history starts here.
TESTNET_START_BLOCK=
TESTNET_MARGIN_ADDRESS=
TESTNET_AUSD_ADDRESS=
TESTNET_FAUCET_ADDRESS=
TESTNET_REGISTRY_ADDRESS=

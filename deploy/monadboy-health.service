[Unit]
Description=Record MONADBOY public HTTPS health
After=network-online.target monadboy-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=monadboy
Group=monadboy
StateDirectory=monadboy
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 20 --write-out "\\n" https://monadboy-api.43.129.38.115.sslip.io/v1/health
StandardOutput=append:/var/lib/monadboy/health.jsonl
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
